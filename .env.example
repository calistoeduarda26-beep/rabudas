# ============================================================
# rabudas - modelo de configuracao (sem valores)
#
#   cp .env.example .env      e preenche tudo.
#   O .env esta no .gitignore e NUNCA deve ser commitado.
#
# Valores por omissao estao nos comentarios.
# ============================================================

# --- NOWPayments (backend apenas; conta em https://account.nowpayments.io) ---
# API key: NOWPayments -> Store settings -> API keys
NOWPAYMENTS_API_KEY=
# Chave publica (store ID). So e necessaria se o frontend a usar.
NOWPAYMENTS_PUBLIC_KEY=
# Gerar em: NOWPayments -> Store settings -> IPN settings.
# Sem este valor, /api/webhooks/nowpayments responde 503 e os depositos
# nao sao creditados automaticamente.
NOWPAYMENTS_IPN_SECRET=
# Por omissao: https://api.nowpayments.io
NOWPAYMENTS_BASE_URL=

# --- Supabase (Project Settings -> API Keys) ---
SUPABASE_URL=
# Chave PUBLICA (sb_publishable_...) - pode ser usada no navegador (login/registo)
SUPABASE_PUBLISHABLE_KEY=
# Chave PRIVADA (sb_secret_...) - SO no backend Python
SUPABASE_SECRET_KEY=
# OPCIONAL: ligacao directa a base de dados, usada apenas por
# `python scripts/init_db.py` para aplicar supabase/schema.sql.
# (Supabase -> Project Settings -> Database -> Connection string, porta 5432)
POSTGRES_URL=

# --- App ---
# String aleatoria de 64 caracteres. Gerar com:
#   python -c "import secrets;print(secrets.token_urlsafe(48)[:64])"
APP_SECRET_KEY=
# URL publica desta aplicacao (usada nos callbacks da NOWPayments).
# OPCIONAL: se ficar vazia, o URL e derivado de cada pedido (x-forwarded-host),
# que e o correcto em serverless (Vercel, Railway, ...).
# Em desenvolvimento local podes por http://localhost:8000
BASE_URL=
# Meticais por 1 USDT. Por omissao: 80
RATE_MT_PER_USDT=
# Deposito minimo em DOLARES (nao em Meticais). Por omissao: 10
# O admin pode alterar na pagina de administracao; este e o valor de recurso
# quando a base de dados nao esta acessivel.
MIN_DEPOSIT_USD=

# --- Servidor (todos opcionais) ---
# Por omissao: development | 0.0.0.0 | 8000 | *
ENVIRONMENT=
HOST=
PORT=
CORS_ORIGINS=
